# ============================================================
# ClassiFace - Environment Configuration (.env)
# Production HTTPS Configuration Example
# ============================================================
# 
# Copy this file to .env and update with your actual values
# IMPORTANT: .env should NEVER be committed to version control
# 
# For production HTTPS deployment:
# 1. Set HTTPS=true to enable secure cookies and headers
# 2. Ensure reverse proxy (nginx/Apache) is handling HTTPS
# 3. Verify SSL certificate is installed on reverse proxy
# 4. Test all security headers before enabling HSTS
#
# ============================================================

# ============================================================
# FLASK CONFIGURATION
# ============================================================
# Secret key for Flask session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your-super-secret-key-here-generate-new-for-production

# Environment: development, staging, or production
FLASK_ENV=production

# Debug mode: ALWAYS set to False in production
FLASK_DEBUG=False

# ============================================================
# HTTPS / SECURITY CONFIGURATION
# ============================================================
# CRITICAL: Set to true in production to enable:
# - SESSION_COOKIE_SECURE (cookies only sent over HTTPS)
# - HSTS headers (enforce HTTPS for 1 year)
# - Other security features
# 
# ONLY SET TO TRUE AFTER:
# 1. SSL certificate is installed on reverse proxy
# 2. HTTP to HTTPS redirect is configured
# 3. Testing confirms HTTPS is working properly
HTTPS=true

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=classiface
DB_USER=classiface_user
DB_PASSWORD=your-secure-database-password-here

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================
# Firebase Web API Key for Web Authentication
# Get from: Firebase Console -> Project Settings -> Web API Key
FIREBASE_WEB_API_KEY=your-firebase-web-api-key-here

# Path to Firebase Admin SDK credentials file
FIREBASE_CREDENTIALS_FILE=classiface-1a8ca-firebase-adminsdk-fbsvc-6dd679b090.json

# Firebase Database URL
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# SMTP settings for sending emails (password resets, notifications, etc.)

# SMTP Server (Gmail example shown)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Use TLS for connection (recommended)
MAIL_USE_TLS=true

# SMTP username (usually email address)
MAIL_USERNAME=your-email@gmail.com

# SMTP password (use app-specific password if using Gmail)
# For Gmail: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your-gmail-app-password-here

# Default sender email address
MAIL_DEFAULT_SENDER=noreply@classiface.edu

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
# Application name
APP_NAME=ClassiFace

# Application base URL (used in emails, redirects, etc.)
# IMPORTANT: Should be HTTPS in production
APP_BASE_URL=https://classiface.yourdomain.com

# File upload configuration
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes

# Camera/Video settings
CAMERA_TIMEOUT=30  # seconds
VIDEO_FRAME_RATE=30
VIDEO_RESOLUTION=720p  # Options: 480p, 720p, 1080p

# Face recognition settings
FACE_MATCH_THRESHOLD=0.6
MIN_FACE_SIZE=20  # minimum face size in pixels
LIVENESS_DETECTION_ENABLED=true

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/classiface.log

# Maximum log file size before rotation (in bytes)
LOG_MAX_BYTES=10485760  # 10MB

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================================
# PRODUCTION SECURITY NOTES
# ============================================================
# 
# 1. DATABASE PASSWORD:
#    - Use strong, unique password
#    - Store securely in production environment
#    - Never commit to version control
# 
# 2. FIREBASE CREDENTIALS:
#    - Keep credential file secure (restricted permissions)
#    - Never commit to version control
#    - Rotate credentials periodically
# 
# 3. SMTP PASSWORD:
#    - For Gmail: Use app-specific password, NOT account password
#    - Store securely in production environment
#    - Never commit to version control
# 
# 4. FLASK_SECRET:
#    - Use cryptographically strong random key
#    - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#    - Store securely in production environment
#    - Never commit to version control
#    - Change if compromised
# 
# 5. HTTPS CONFIGURATION:
#    - ALWAYS use HTTPS in production
#    - Certificate must be installed on reverse proxy (nginx/Apache)
#    - Verify certificate before setting HTTPS=true
#    - HSTS header enforces HTTPS for 1 year once set
# 
# 6. ENVIRONMENT VARIABLES:
#    - Load from .env file (not committed to version control)
#    - Alternative: Use secure system environment variables
#    - In Docker/Kubernetes: Use secrets management
#    - In systemd service: Use EnvironmentFile= directive
# 
# 7. FIREWALL:
#    - Only expose ports 80 (HTTP redirect) and 443 (HTTPS)
#    - Block port 5000 (Flask app) from external access
#    - Only localhost (127.0.0.1) should access Flask app
# 
# 8. MONITORING:
#    - Monitor error logs regularly
#    - Set up alerts for SSL certificate expiration
#    - Monitor for unauthorized access attempts
#    - Monitor application performance and uptime
# 
# 9. BACKUPS:
#    - Regular database backups
#    - Backup SSL certificate and keys
#    - Test restore procedures
# 
# 10. UPDATES:
#     - Keep OS and all software updated
#     - Subscribe to security advisories
#     - Plan regular maintenance windows

# ============================================================
# EXAMPLE: DOCKER / KUBERNETES SECRET MANAGEMENT
# ============================================================
# Instead of .env file, use secrets management:
# 
# Kubernetes example:
#   kubectl create secret generic classiface-secrets \
#     --from-literal=FLASK_SECRET=... \
#     --from-literal=DB_PASSWORD=... \
#     --from-literal=FIREBASE_WEB_API_KEY=... \
#     --from-literal=MAIL_PASSWORD=...
# 
# Then reference in deployment:
#   containers:
#     - name: classiface
#       env:
#         - name: FLASK_SECRET
#           valueFrom:
#             secretKeyRef:
#               name: classiface-secrets
#               key: FLASK_SECRET
# 
# Docker example:
#   docker run -e FLASK_SECRET=... -e DB_PASSWORD=... classiface:latest
# 
# Systemd service example:
#   [Service]
#   EnvironmentFile=/etc/classiface/.env
#   ExecStart=/usr/bin/python3 /app/app.py
#
# ============================================================
