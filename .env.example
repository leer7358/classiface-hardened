# Generate a local value with:
#   powershell -NoProfile -Command "$bytes = New-Object byte[] 32; $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($bytes); $rng.Dispose(); [Convert]::ToBase64String($bytes)"
EMBED_KEY="replace-with-base64-encoded-32-byte-key"

# Flask session signing secret.
FLASK_SECRET="replace-with-random-secret"

# Firebase Web Auth API key used by browser login/register flows.
FIREBASE_WEB_API_KEY="replace-with-firebase-web-api-key"

# Optional PostgreSQL overrides.
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="classiface"
PGUSER="postgres"
PGPASSWORD="replace-with-local-password"
